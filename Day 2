//question 8
#include<stdio.h>
#include<conio.h>

void main()
{
    int n, temp, rem, rev = 0;

    clrscr();

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while(n != 0)
    {
        rem = n % 10;
        rev = rev * 10 + rem;
        n = n / 10;
    }

    if(temp == rev)
        printf("Palindrome Number");
    else
        printf("Not a Palindrome Number");

    getch();
}