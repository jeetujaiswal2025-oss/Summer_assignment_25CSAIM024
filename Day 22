/* Question 85 : Check Palindrome String */

#include<stdio.h>
#include<string.h>

void main()
{
    char str[100];
    int i,len,flag=1;

    gets(str);

    len=strlen(str);

    for(i=0;i<len/2;i++)
    {
        if(str[i]!=str[len-1-i])
        {
            flag=0;
            break;
        }
    }

    if(flag)
        printf("Palindrome");
    else
        printf("Not Palindrome");
}

/* Question 86 : Count Words in a Sentence */

#include<stdio.h>

void main()
{
    char str[100];
    int i,count=1;

    gets(str);

    for(i=0;str[i]!='\0';i++)
    {
        if(str[i]==' ')
            count++;
    }

    printf("Words = %d",count);
}

/* Question 87 : Character Frequency */

#include<stdio.h>

void main()
{
    char str[100],ch;
    int i,count=0;

    gets(str);

    scanf("%c",&ch);

    for(i=0;str[i]!='\0';i++)
    {
        if(str[i]==ch)
            count++;
    }

    printf("Frequency = %d",count);
}

/* Question 88 : Remove Spaces from String */

#include<stdio.h>

void main()
{
    char str[100];
    int i,j=0;

    gets(str);

    for(i=0;str[i]!='\0';i++)
    {
        if(str[i]!=' ')
        {
            str[j]=str[i];
            j++;
        }
    }

    str[j]='\0';

    puts(str);
}