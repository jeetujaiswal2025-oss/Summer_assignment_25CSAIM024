/* Question 93 : Check String Rotation */

#include<stdio.h>
#include<string.h>

void main()
{
    char str1[100],str2[100],temp[200];

    gets(str1);
    gets(str2);

    strcpy(temp,str1);
    strcat(temp,str1);

    if(strstr(temp,str2))
        printf("String Rotation");
    else
        printf("Not String Rotation");
}

/* Question 94 : Compress a String */

#include<stdio.h>
#include<string.h>

void main()
{
    char str[100];
    int i,count;

    gets(str);

    for(i=0;str[i]!='\0';i++)
    {
        count=1;

        while(str[i]==str[i+1])
        {
            count++;
            i++;
        }

        printf("%c%d",str[i],count);
    }
}

/* Question 95 : Find Longest Word */

#include<stdio.h>
#include<string.h>

void main()
{
    char str[100],word[50],longest[50];
    int i=0,j=0,max=0;

    gets(str);

    while(1)
    {
        if(str[i]==' ' || str[i]=='\0')
        {
            word[j]='\0';

            if(j>max)
            {
                max=j;
                strcpy(longest,word);
            }

            j=0;

            if(str[i]=='\0')
                break;
        }
        else
        {
            word[j++]=str[i];
        }

        i++;
    }

    printf("Longest Word = %s",longest);
}

/* Question 96 : Remove Duplicate Characters */

#include<stdio.h>
#include<string.h>

void main()
{
    char str[100];
    int i,j;

    gets(str);

    for(i=0;str[i]!='\0';i++)
    {
        for(j=0;j<i;j++)
        {
            if(str[i]==str[j])
                break;
        }

        if(j==i)
            printf("%c",str[i]);
    }
}