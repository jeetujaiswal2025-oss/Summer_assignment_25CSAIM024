/* Question 97 : Merge Two Sorted Arrays */

#include<stdio.h>

void main()
{
    int a[50],b[50],c[100];
    int n1,n2,i,j,k=0;

    scanf("%d",&n1);
    for(i=0;i<n1;i++)
        scanf("%d",&a[i]);

    scanf("%d",&n2);
    for(i=0;i<n2;i++)
        scanf("%d",&b[i]);

    i=0;
    j=0;

    while(i<n1 && j<n2)
    {
        if(a[i]<b[j])
            c[k++]=a[i++];
        else
            c[k++]=b[j++];
    }

    while(i<n1)
        c[k++]=a[i++];

    while(j<n2)
        c[k++]=b[j++];

    for(i=0;i<k;i++)
        printf("%d ",c[i]);
}

/* Question 98 : Find Common Characters in Strings */

#include<stdio.h>
#include<string.h>

void main()
{
    char s1[100],s2[100];
    int i,j;

    gets(s1);
    gets(s2);

    for(i=0;s1[i]!='\0';i++)
    {
        for(j=0;s2[j]!='\0';j++)
        {
            if(s1[i]==s2[j])
            {
                printf("%c ",s1[i]);
                break;
            }
        }
    }
}

/* Question 99 : Sort Names Alphabetically */

#include<stdio.h>
#include<string.h>

void main()
{
    char name[5][50],temp[50];
    int i,j;

    for(i=0;i<5;i++)
        gets(name[i]);

    for(i=0;i<4;i++)
    {
        for(j=i+1;j<5;j++)
        {
            if(strcmp(name[i],name[j])>0)
            {
                strcpy(temp,name[i]);
                strcpy(name[i],name[j]);
                strcpy(name[j],temp);
            }
        }
    }

    for(i=0;i<5;i++)
        puts(name[i]);
}

/* Question 100 : Sort Words by Length */

#include<stdio.h>
#include<string.h>

void main()
{
    char words[5][50],temp[50];
    int i,j;

    for(i=0;i<5;i++)
        gets(words[i]);

    for(i=0;i<4;i++)
    {
        for(j=i+1;j<5;j++)
        {
            if(strlen(words[i])>strlen(words[j]))
            {
                strcpy(temp,words[i]);
                strcpy(words[i],words[j]);
                strcpy(words[j],temp);
            }
        }
    }

    for(i=0;i<5;i++)
        puts(words[i]);
}