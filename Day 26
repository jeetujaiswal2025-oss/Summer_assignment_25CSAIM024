/* Question 103 : ATM Simulation */

#include<stdio.h>

void main()
{
    int choice;
    float balance=10000,amount;

    printf("1.Deposit\n2.Withdraw\n3.Check Balance\n");
    scanf("%d",&choice);

    switch(choice)
    {
        case 1:
            scanf("%f",&amount);
            balance+=amount;
            printf("Balance = %.2f",balance);
            break;

        case 2:
            scanf("%f",&amount);

            if(amount<=balance)
            {
                balance-=amount;
                printf("Balance = %.2f",balance);
            }
            else
                printf("Insufficient Balance");
            break;

        case 3:
            printf("Balance = %.2f",balance);
            break;

        default:
            printf("Invalid Choice");
    }
}

/* Question 104 : Quiz Application */

#include<stdio.h>

void main()
{
    int ans,score=0;

    printf("Capital of India?\n");
    printf("1.Delhi 2.Mumbai 3.Kolkata\n");
    scanf("%d",&ans);

    if(ans==1)
        score++;

    printf("2 + 2 = ?\n");
    printf("1.3 2.4 3.5\n");
    scanf("%d",&ans);

    if(ans==2)
        score++;

    printf("Score = %d",score);
}