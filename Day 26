/* Question 101 : Number Guessing Game */

#include<stdio.h>

void main()
{
    int number=25,guess;

    printf("Guess a number: ");
    scanf("%d",&guess);

    if(guess==number)
        printf("Correct Guess");
    else if(guess<number)
        printf("Too Low");
    else
        printf("Too High");
}

