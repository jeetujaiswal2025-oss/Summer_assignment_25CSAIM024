/* Question 105 : Student Record Management System */

#include<stdio.h>

struct student
{
    int roll;
    char name[30];
    float marks;
};

void main()
{
    struct student s;

    printf("Enter Roll No: ");
    scanf("%d",&s.roll);

    printf("Enter Name: ");
    scanf("%s",s.name);

    printf("Enter Marks: ");
    scanf("%f",&s.marks);

    printf("\nStudent Details\n");
    printf("Roll No = %d\n",s.roll);
    printf("Name = %s\n",s.name);
    printf("Marks = %.2f\n",s.marks);
}


